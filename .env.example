# Borough configuration
TARGET_BOROUGHS=Lambeth,Southwark,Wandsworth,Lewisham,Merton,Croydon,City of London,Westminster

# Notion
NOTION_API_KEY=secret_xxx
NOTION_ROADWORKS_DB_ID=xxx
NOTION_DISRUPTIONS_DB_ID=xxx

# TfL (optional — works without key at lower rate limits)
TFL_API_KEY=

# Anthropic (optional — for Claude cycling impact summaries)
ANTHROPIC_API_KEY=sk-ant-xxx

# App
WEBHOOK_PATH=/webhook/street-manager
LOG_LEVEL=INFO
